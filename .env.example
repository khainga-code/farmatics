# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development

# Public base URL of the API
PORT=4000
HOST=0.0.0.0

# Where the browser app runs (comma separated list)
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Runtime connection. In production this is the RLS-restricted role
# (farmatics_app).
#
# Leave both URLs unset for local development: the API then runs an embedded
# Postgres in DATABASE_DIR, with no install and no server to start.
# DATABASE_URL=postgres://farmatics_app:local_dev_password@localhost:5432/farmatics
# DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/farmatics

# Local embedded Postgres data directory (PGlite).
DATABASE_DIR=.data/pg

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ random bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-do-not-use-in-production-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10

# SMS provider: 'stub' logs codes to the console (development only).
SMS_PROVIDER=stub

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
# The API refuses to start in production without an explicit https browser
# origin and a 32+ character JWT_SECRET.
# NODE_ENV=production
# CORS_ORIGINS=https://farmatics.<account>.workers.dev
# JWT_SECRET=<generate a new one; do not reuse the development value>
#
# Both database URLs are required in production. DATABASE_URL connects as the
# RLS-restricted role; DATABASE_ADMIN_URL connects as the owner. Add
# ?sslmode=require when the host requires TLS.
#
# Apply migrations as a separate step, or set AUTO_MIGRATE=true to run them
# when the API boots.
# AUTO_MIGRATE=true
#
# Owner registration sends a one-time code by SMS, so production needs a real
# provider.
# SMS_PROVIDER=africastalking
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=

# The browser app reads VITE_API_URL at build time, not at runtime, so it is
# not read from this file. Set it in the web build environment (Cloudflare
# Build variables) or in apps/web/.env.production. See docs/PHASE-8.md.
# VITE_API_URL=https://api.farm.example.com
